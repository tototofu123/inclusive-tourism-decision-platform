# ── LLM Provider ──
GEMINI_API_KEY=           # AI Studio key, e.g. AQ...
LLM_PROVIDER=gemini       # gemini | vertex | local | custom
LLM_MODEL=gemini-2.0-flash-001

# ── Local llama.cpp ──
LLAMA_HOST=http://127.0.0.1:8081
LLAMA_MODELS_DIR=         # e.g. C:\Users\...\.llama\models

# ── Custom API ──
CUSTOM_API_URL=
CUSTOM_API_KEY=

# ── Google Maps / Places / Routes ──
MAPS_API_KEY=

# ── Overpass API ──
OVERPASS_BASE=https://overpass-api.de/api/interpreter

# ── OSRM ──
OSRM_BASE=https://router.project-osrm.org

# ── PostgreSQL ──
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=inclusive_tourism_v1

# ── Cloud SQL (overrides PG* when set) ──
CLOUD_SQL_HOST=
CLOUD_SQL_PORT=5432
CLOUD_SQL_USER=
CLOUD_SQL_PASSWORD=
CLOUD_SQL_DATABASE=

# ── Security ──
PIPELINE_TOKEN=           # Bearer token for POST /places/pipeline
APP_ORIGIN=http://localhost:3000

# ── Server ──
PORT=4000
