# V3 Environment Variables Example
# Copy to .env.local and fill in real values. Never commit real keys.

# Maps & Geolocation
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
NEXT_PUBLIC_MAP_DEFAULT_LAT=22.3193
NEXT_PUBLIC_MAP_DEFAULT_LNG=114.1694
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=13

# Backend / API
NEXT_PUBLIC_API_BASE_URL=https://your-api.vercel.app/api

# AI / Decision Intelligence
OPENAI_API_KEY=your_openai_api_key_here
NEXT_PUBLIC_AI_FEATURE_FLAG=true

# Accessibility Data
NEXT_PUBLIC_ACCESSIBILITY_DATA_ENDPOINT=https://your-data-source.com/api/places

# Vercel & Deployment
VERCEL_ENV=production
NEXT_PUBLIC_APP_VERSION=v3
NEXT_PUBLIC_APP_NAME=Inclusive Tourism HK
