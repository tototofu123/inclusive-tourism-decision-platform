# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── AI Mode ─────────────────────────────────────────────────────────────────
# Set to true to use Vertex AI + ADK. false = local llama.cpp + SQLite only.
VERTEX_AI_ENABLED=false

# ─── Google Cloud (required when VERTEX_AI_ENABLED=true) ─────────────────────
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.0-flash

# Vertex AI Vector Search
VERTEX_VECTOR_INDEX_ENDPOINT=your-index-endpoint-id
VERTEX_DEPLOYED_INDEX_ID=your-deployed-index-id

# AlloyDB (PostgreSQL-compatible)
ALLOYDB_CONNECTION_STRING=postgresql://user:password@/database?host=/cloudsql/project:region:instance

# Google Maps
MAPS_API_KEY=your-google-maps-api-key

# BigQuery Analytics (optional — won't break anything if disabled)
BIGQUERY_ENABLED=false
BIGQUERY_DATASET=inclusive_tourism
BIGQUERY_TABLE=usage_events

# Google service account (if not using Application Default Credentials)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
