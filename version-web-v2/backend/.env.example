# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inclusive_tourism
DB_USER=postgres
DB_PASSWORD=your_password_here

# AI Gateway - local llama.cpp server
# Run: ./llama-server -m models/llama-3.2-3b-q4.gguf --port 8080
LLAMA_BASE_URL=http://localhost:8080
LLAMA_MODEL=llama-3.2-3b

# Routing (free tier for MVP)
ORS_BASE_URL=https://api.openrouteservice.org/v2
ORS_API_KEY=your_ors_key_here

# Frontend origin (CORS)
FRONTEND_URL=http://localhost:3000
